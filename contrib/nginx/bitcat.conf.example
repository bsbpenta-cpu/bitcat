# Add these locations to the server block of the reverse proxy that already
# serves your public IP/domain, then validate and reload that proxy.
#
# proxy_pass intentionally has no trailing slash: the /bitcat/ prefix must be
# preserved because BITCART_BASE_PATH is set to /bitcat in deploy-bitcat.sh.
location = /bitcat {
    return 301 /bitcat/;
}

location /bitcat/ {
    proxy_pass http://127.0.0.1:10080;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    proxy_read_timeout 600s;
    proxy_send_timeout 600s;
}
